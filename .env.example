# ══════════════════════════════════════════════════════════════════════════
# qq-dsh 环境变量（可选覆盖项）
# ══════════════════════════════════════════════════════════════════════════
#
# 全部都是**可选**的，留空即用 config.json 或默认值。
# 这份文件被 `npm start` 通过 `--env-file-if-exists=.env` 读取。
#
# ⚠️ 注意：DSH 独立启动的 MCP 进程**不会自动继承**这里的变量。
#    如果 MCP 是 DSH 拉起的（不是你手动跑的），它读的是自己的环境 ——
#    这类情况下请改 config.json，或者在你的 DSH 启动配置里设环境变量。

# ── DSH 连接 ──────────────────────────────────────────────────────────────

# DSH Desktop 的地址（和 config.json 的 dsh.baseUrl 等价）
# 例：http://127.0.0.1:43129
# 端口不是固定的，看你的 DSH 实际监听哪个
DSH_WEB_URL=

# DSH 的鉴权 token
# 一般不用填：桥接会用 ~/.dsh 里持久化的会话签名密钥离线铸造 Cookie
DSH_AUTH_TOKEN=

# DSH 凭据目录（默认 %APPDATA%\dsh-desktop\harness）
# 装在别处或想用另一份配置时才需要设
# DSH_HOME=

# DSH profile 名（默认 web）。多开或自定义 profile 时改这个
# DSH_PROFILE=


# ── OneBot / SnowLuma ─────────────────────────────────────────────────────

# SnowLuma 的 WebSocket 地址
# ⚠️ HTTP 和 WS 用的是**两套不同的 token**（见下面两行）
# 例：ws://127.0.0.1:3001
ONEBOT_WS_URL=

# SnowLuma 的 HTTP API 地址
# 例：http://127.0.0.1:3000
ONEBOT_HTTP_URL=

# OneBot 的 access token（HTTP 用的那个）
# 从哪拿：SnowLuma 控制台 → 网络配置 → HTTP 服务器的 accessToken
# 或 SnowLuma/config/onebot_<QQ号>.json 里的 networks.httpServers[0].accessToken
ONEBOT_ACCESS_TOKEN=


# ── 桥接控制台 ────────────────────────────────────────────────────────────

# 控制台 token（默认自动生成并存到 state/console-token）
# 只在想固定一个值时才填
QQ_BRIDGE_CONSOLE_TOKEN=


# ── 媒体处理 ──────────────────────────────────────────────────────────────

# FFmpeg / FFprobe 路径。留空则用系统 PATH 里的。
# ⚠️ 生成视频需要 h264 编码器。RVC 自带的精简版可能没有 libx264，
#    但支持 h264_mf / h264_nvenc / h264_qsv，够用。
FFMPEG_PATH=
FFPROBE_PATH=


# ── 点歌（qq_song）────────────────────────────────────────────────────────

# 装了 bilibili-api-python 的 Python 解释器
# 建议单独建 venv：
#   python -m venv .venv
#   .venv\Scripts\pip install bilibili-api-python yt-dlp
# 例：C:\path\to\.venv\Scripts\python.exe
BILI_PYTHON=


# ── RVC 音色转换（qq_sing / qq_song）──────────────────────────────────────

# RVC 项目根目录（含 rvc_infer.py 的那层）
RVC_DIR=

# RVC 的启动脚本目录（通常同 RVC_DIR）
RVC_SCRIPTS_DIR=

# RVC 自带 runtime 的 python
# 例：<RVC_DIR>\runtime\python.exe
RVC_PYTHON=

# 推理脚本路径（默认 <RVC_DIR>\rvc_infer.py）
RVC_INFER_SCRIPT=


# ── 语音合成与识别 ────────────────────────────────────────────────────────

# 装了 FunASR 的 Python（语音转文字 / 抖音口播转写）
# GPT-SoVITS 自带的 runtime 通常已装好 FunASR，可以直接指过去
ASR_PYTHON=

# ASR 脚本路径（默认 <仓库>/src/douyin/douyin_transcribe.py）
ASR_SCRIPT=

# GPT-SoVITS runtime 的 python（ASR 也会复用这个）
# 例：<GPT-SoVITS>\runtime\python.exe
TTS_PYTHON=


# ── 抖音 ──────────────────────────────────────────────────────────────────

# 抖音适配目录（默认 <仓库>/src/douyin，一般不用改）
DOUYIN_DIR=

# 抖音**写操作**开关（发评论 / 回复 / 发作品）
# 0 = 全部禁用，只允许读（默认）
# 1 = 允许 AI 真的去评论、回复、发作品
# ⚠️ 这是不可逆的公开操作，确认白名单配好了再开
DOUYIN_ALLOW_WRITES=0


# ── ComfyUI ───────────────────────────────────────────────────────────────

# ComfyUI 地址（画图 / 视频用）
# 例：http://127.0.0.1:8188
COMFY_URL=
